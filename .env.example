# Copy to .env.local and fill in. Never commit real values.

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Model used for reviews. See https://platform.claude.com/docs/en/about-claude/models
ANTHROPIC_MODEL=claude-opus-5-5

# --- Review limits ---
# Reviews are refused above this many characters of diff (after skipping lockfiles etc).
MAX_DIFF_CHARS=60000
# Budget for full-file context sent along with the diff. Files that do not fit are left out.
MAX_CONTEXT_CHARS=120000

# --- GitHub App ---
GITHUB_APP_ID=
# The .pem contents. Newlines may be written as \n on one line.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Auth.js (dashboard login) ---
# Generate with: npx auth secret
AUTH_SECRET=
# OAuth credentials of the same GitHub App (Client ID / Client secret).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- App ---
# Public base URL, used for links from GitHub back to the dashboard.
APP_URL=http://localhost:3000

# Optional. The pull request shown on the public /demo page, as owner/repo#number.
# Use a public repository only. Keep the quotes in a .env file: without them
# everything from the "#" on is read as a comment.
# DEMO_PULL_REQUEST="your-org/your-repo#12"
DEMO_PULL_REQUEST=

# --- Paste mode limits ---
PASTE_MAX_CHARS=20000
PASTE_REQUESTS_PER_HOUR=20
PASTE_DAILY_GLOBAL_LIMIT=100
