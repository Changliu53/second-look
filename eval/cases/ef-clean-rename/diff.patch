+
+    public async Task<List<Customer>> FindByPhoneAsync(string primaryPhone, CancellationToken ct)
+    {
+        return await _db.Customers
+            .Where(c => c.TenantId == _tenant.TenantId && c.PrimaryPhone == primaryPhone)
+            .OrderBy(c => c.Name)
+            .Take(20)
+            .ToListAsync(ct);
+    }
 }
