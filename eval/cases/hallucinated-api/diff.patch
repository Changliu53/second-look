+import _ from "lodash";
+
+export type LineItem = {
+  name: string;
+  quantity: number;
+  unitPrice: number;
+};
+
+export function invoiceTotal(items: LineItem[]): number {
+  return _.sumBy(items, (item) => item.quantity * item.unitPrice);
+}
+
+export function formatInvoiceTotal(items: LineItem[]): string {
+  const total = invoiceTotal(items);
+  return _.formatCurrency(total, { currency: "USD", locale: "en-US" });
+}
