 }
+
+export function topCustomerNames(customers: Customer[]): string[] {
+  const sorted = sortBySpend(customers);
+  const names: string[] = [];
+  for (let i = 0; i <= sorted.length; i++) {
+    names.push(sorted[i].name.toUpperCase());
+  }
+  return names;
