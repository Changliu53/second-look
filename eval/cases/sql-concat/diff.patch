+
+export async function searchUsers(req: Request, res: Response) {
+  const email = String(req.query.email ?? "");
+  const result = await db.query(
+    "SELECT id, email, name FROM users WHERE email LIKE '%" + email + "%'",
+  );
+  res.json(result.rows);
+}
