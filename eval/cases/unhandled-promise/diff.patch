diff --git a/src/jobs/sync-orders.ts b/src/jobs/sync-orders.ts
index 2ba5e28..51e0f65 100644
--- a/src/jobs/sync-orders.ts
+++ b/src/jobs/sync-orders.ts
@@ -1,3 +1,15 @@
 import { saveOrders } from "../db/orders";
 
 const ORDERS_URL = "https://api.shop.example.com/v1/orders";
+
+async function syncOrders(): Promise<void> {
+  const response = await fetch(ORDERS_URL);
+  const orders = await response.json();
+  await saveOrders(orders);
+}
+
+export function startOrderSync(): void {
+  setInterval(() => {
+    syncOrders();
+  }, 60_000);
+}
